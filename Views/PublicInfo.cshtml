@model PublicInfoModel

@{
    //footer, not <head> (render-blocking): the theme adds Alpine as the last footer script (Nopwara's Head.cshtml), so this
    //script's alpine:init listener is registered before Alpine starts. Themes listed in the plugin's "allowed themes" must do the same.
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Plugins/{NopwaraSearchDefaults.PLUGIN_FOLDER}/Content/js/nopwara-search.js");
}

@*
    Nopwara instant search. Rendered in the "searchbox" widget zone, i.e. inside the header search <form>.
    The Alpine component attaches to the form's existing .search-box-text input and .search-box-category select;
    the panel is positioned against the theme's .search-box wrapper (position: relative).
*@
<div class="nopwara-search contents"
     x-data="nopwaraSearch"
     data-suggest-url="@Model.SuggestUrl"
     data-delete-url="@Model.DeleteTermUrl"
     data-min-length="@Model.MinTermLength"
     data-debounce="@Model.DebounceMs"
     data-show-images="@Model.ShowImages.ToString().ToLowerInvariant()"
     data-see-all="@T("Plugins.Widgets.NopwaraSearch.SeeAll").Text"
     data-no-results="@T("Plugins.Widgets.NopwaraSearch.NoResults").Text"
     data-title-products="@T("Plugins.Widgets.NopwaraSearch.Products").Text"
     data-title-categories="@T("Plugins.Widgets.NopwaraSearch.Categories").Text"
     data-title-manufacturers="@T("Plugins.Widgets.NopwaraSearch.Manufacturers").Text"
     data-title-recent="@T("Plugins.Widgets.NopwaraSearch.Recent").Text"
     data-title-popular="@T("Plugins.Widgets.NopwaraSearch.Popular").Text"
     data-loading="@T("Plugins.Widgets.NopwaraSearch.Loading").Text">
    <div id="nopwara-search-panel"
         x-ref="panel"
         x-show="open"
         x-cloak
         x-transition:enter="transition duration-150 ease-out"
         x-transition:enter-start="opacity-0 -translate-y-1"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition duration-100 ease-in"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         role="listbox"
         aria-label="@T("Search")"
         class="absolute inset-x-0 top-full z-50 mt-2 max-h-[70vh] lg:right-auto lg:w-[max(100%,30rem)] overflow-y-auto overscroll-contain rounded-xl border border-slate-200 bg-white text-left shadow-xl">

        @*loading bar*@
        <div class="h-0.5 overflow-hidden" aria-hidden="true">
            <div class="h-full w-1/3 animate-pulse bg-primary-500" x-show="loading"></div>
        </div>
        <p class="sr-only" role="status" aria-live="polite" x-text="loading ? labels.loading : status"></p>

        @*nothing found*@
        <template x-if="noResults">
            <p class="px-4 pb-1 pt-4 text-sm text-slate-600" x-text="format(labels.noResults, term)"></p>
        </template>

        <template x-for="section in sections" :key="section.key">
            <div class="py-2" :class="section.key === 'products' ? '' : 'border-t border-slate-100 first:border-t-0'">
                <p class="px-4 pb-1 pt-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400" x-text="section.title"></p>

                @*products: thumb, name (highlighted), price*@
                <template x-if="section.key === 'products'">
                    <ul class="px-2">
                        <template x-for="item in section.items" :key="item.i">
                            <li>
                                <a :href="item.url" :id="'nopwara-search-opt-' + item.i" role="option" :aria-selected="active === item.i"
                                   x-on:mouseenter="active = item.i"
                                   class="flex items-center gap-3 rounded-lg px-2 py-2 transition-colors"
                                   :class="active === item.i ? 'bg-primary-50' : 'hover:bg-slate-50'">
                                    <template x-if="showImages">
                                        <span class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-md border border-slate-100 bg-white">
                                            <img x-show="item.image" :src="item.image" alt="" loading="lazy" class="size-full object-contain">
                                        </span>
                                    </template>
                                    <span class="min-w-0 flex-1">
                                        <span class="line-clamp-2 text-sm text-slate-800 [&_mark]:bg-transparent [&_mark]:font-semibold [&_mark]:text-slate-950" x-html="highlight(item.name)"></span>
                                        <span class="mt-0.5 flex items-baseline gap-2 text-sm" x-show="item.price">
                                            <span class="font-semibold text-slate-900" x-text="item.price"></span>
                                            <span class="text-xs text-slate-400 line-through" x-show="item.oldPrice" x-text="item.oldPrice"></span>
                                        </span>
                                    </span>
                                </a>
                            </li>
                        </template>
                    </ul>
                </template>

                @*categories / brands: name + parent path*@
                <template x-if="section.key === 'categories' || section.key === 'manufacturers'">
                    <ul class="px-2">
                        <template x-for="item in section.items" :key="item.i">
                            <li>
                                <a :href="item.url" :id="'nopwara-search-opt-' + item.i" role="option" :aria-selected="active === item.i"
                                   x-on:mouseenter="active = item.i"
                                   class="flex items-center gap-2 rounded-lg px-2 py-2 text-sm transition-colors"
                                   :class="active === item.i ? 'bg-primary-50' : 'hover:bg-slate-50'">
                                    <svg class="size-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" /></svg>
                                    <span class="min-w-0 truncate text-slate-800 [&_mark]:bg-transparent [&_mark]:font-semibold [&_mark]:text-slate-950" x-html="highlight(item.name)"></span>
                                    <span class="ml-auto shrink-0 truncate text-xs text-slate-400" x-show="item.path" x-text="item.path"></span>
                                </a>
                            </li>
                        </template>
                    </ul>
                </template>

                @*recent / popular terms as chips*@
                <template x-if="section.key === 'recent' || section.key === 'popular'">
                    <ul class="flex flex-wrap gap-2 px-4 pb-2 pt-1">
                        <template x-for="item in section.items" :key="item.i">
                            <li class="inline-flex items-center rounded-full border text-sm transition-colors"
                                :class="active === item.i ? 'border-primary-500 bg-primary-50 text-primary-700' : 'border-slate-200 text-slate-700 hover:border-slate-300'">
                                <a :href="item.url" :id="'nopwara-search-opt-' + item.i" role="option" :aria-selected="active === item.i"
                                   x-on:mouseenter="active = item.i"
                                   class="inline-flex items-center gap-1.5 py-1 pl-3" :class="section.key === 'recent' ? 'pr-1' : 'pr-3'">
                                    <svg x-show="section.key === 'recent'" class="size-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                                    <svg x-show="section.key === 'popular'" class="size-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
                                    <span x-text="item.name"></span>
                                </a>
                                <button type="button" x-show="section.key === 'recent'"
                                        class="mr-1 rounded-full p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700"
                                        aria-label="@T("Plugins.Widgets.NopwaraSearch.Remove")"
                                        x-on:click.prevent.stop="removeTerm(item.name)">
                                    <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                                </button>
                            </li>
                        </template>
                    </ul>
                </template>
            </div>
        </template>

        @*see all results*@
        <template x-if="seeAll">
            <a :href="seeAll.url" :id="'nopwara-search-opt-' + seeAll.i" role="option" :aria-selected="active === seeAll.i"
               x-on:mouseenter="active = seeAll.i"
               class="flex items-center justify-between gap-2 border-t border-slate-100 px-4 py-3 text-sm font-semibold text-primary-700 transition-colors"
               :class="active === seeAll.i ? 'bg-primary-50' : 'hover:bg-slate-50'">
                <span x-text="format(labels.seeAll, seeAll.count)"></span>
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
        </template>
    </div>
</div>
